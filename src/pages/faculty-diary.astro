---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getFacultyTimetable,
  getSyllabusUnits,
  getMentorshipRemarks,
  getCourseMaterials,
  getResearchPapers,
} from '../lib/supabase';

const { userId } = Astro.locals.auth();
const activeUserId = userId || 'guest_user';

const [schedule, syllabusUnits, remarks, resources, researchPapers] = await Promise.all([
  getFacultyTimetable(activeUserId),
  getSyllabusUnits(activeUserId),
  getMentorshipRemarks(activeUserId),
  getCourseMaterials(activeUserId),
  getResearchPapers(activeUserId),
]);
---

<BaseLayout title="Faculty Academic Diary" activePage="faculty-diary">
  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-8">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-50 border border-rose-200 text-xs text-brand-coral-dark font-semibold mb-2">
        <span>📚</span>
        <span>Academic Operations & Mentorship Suite • Supabase DB</span>
      </div>
      <h1 class="text-3xl font-extrabold text-ink tracking-tight">Faculty Academic Diary</h1>
      <p class="text-slate-600 text-sm mt-1">Manage weekly timetable, track curriculum completion, record student mentorship, and publish research.</p>
    </div>

    <!-- Quick Action -->
    <div class="flex items-center gap-3">
      <button
        onclick="openAddRemarkModal()"
        class="btn-primary"
      >
        <span>+ Add Student Remark</span>
      </button>
    </div>
  </div>

  <!-- Diary Tabs Navigation (DESIGN.md pill-tab style) -->
  <div class="flex flex-wrap gap-2 pb-4 mb-6 border-b border-hairline">
    <button data-diary-tab="schedule" class="diary-tab-btn px-4 py-2 rounded-full text-xs font-semibold bg-ink text-white active-diary-tab shadow-sm cursor-pointer">
      📅 Weekly Timetable ({schedule ? schedule.length : 0})
    </button>
    <button data-diary-tab="syllabus" class="diary-tab-btn px-4 py-2 rounded-full text-xs font-semibold bg-white border border-hairline text-slate-600 hover:text-ink cursor-pointer hover:bg-surface">
      📊 Syllabus Coverage ({syllabusUnits ? syllabusUnits.length : 0})
    </button>
    <button data-diary-tab="remarks" class="diary-tab-btn px-4 py-2 rounded-full text-xs font-semibold bg-white border border-hairline text-slate-600 hover:text-ink cursor-pointer hover:bg-surface">
      💬 Mentorship & Remarks ({remarks ? remarks.length : 0})
    </button>
    <button data-diary-tab="resources" class="diary-tab-btn px-4 py-2 rounded-full text-xs font-semibold bg-white border border-hairline text-slate-600 hover:text-ink cursor-pointer hover:bg-surface">
      📂 Course Materials ({resources ? resources.length : 0})
    </button>
    <button data-diary-tab="research" class="diary-tab-btn px-4 py-2 rounded-full text-xs font-semibold bg-white border border-hairline text-slate-600 hover:text-ink cursor-pointer hover:bg-surface">
      🔬 Research & Grants ({researchPapers ? researchPapers.length : 0})
    </button>
  </div>

  <!-- TAB 1: WEEKLY TIMETABLE -->
  <div id="diary-pane-schedule" class="diary-pane space-y-4">
    {schedule && schedule.length > 0 ? (
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
        {schedule.map((item: any) => (
          <div class="card-hover p-5 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold uppercase px-3 py-0.5 rounded-full bg-indigo-50 text-brand-blue border border-indigo-200">
                  {item.day_of_week}
                </span>
                <span class="text-[10px] text-slate-500 font-mono font-medium bg-surface px-2 py-0.5 rounded-full border border-hairline">
                  {item.room || 'Room'}
                </span>
              </div>
              <h3 class="font-bold text-sm text-ink mb-1">{item.course_name}</h3>
              <p class="text-xs text-slate-600 font-medium mb-3">Topic: <strong class="text-ink">{item.topic || 'General Lecture'}</strong></p>
            </div>
            <div class="pt-3 border-t border-hairline flex items-center justify-between text-xs">
              <span class="text-slate-500 font-mono text-[11px] font-medium">{item.time_slot}</span>
              <a
                href="/attendance"
                class="text-[11px] font-bold text-brand-blue hover:underline flex items-center gap-1"
              >
                <span>Take Attendance</span> →
              </a>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="card-base p-12 text-center text-slate-500 space-y-3">
        <div class="text-3xl">📅</div>
        <h3 class="font-bold text-sm text-ink">No Lecture Timetable Scheduled</h3>
        <p class="text-xs text-slate-600 max-w-sm mx-auto">Your schedule items will be populated from your Supabase faculty_timetable records.</p>
      </div>
    )}
  </div>

  <!-- TAB 2: SYLLABUS COVERAGE -->
  <div id="diary-pane-syllabus" class="diary-pane hidden space-y-6">
    <div class="card-base p-6 sm:p-8">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-hairline">
        <div>
          <h2 class="text-lg font-bold text-ink">Curriculum & Syllabus Progress Tracker</h2>
          <p class="text-xs text-slate-600 mt-0.5">Track topic completion and sync progress with your academic records.</p>
        </div>
        <button
          onclick="window.showToast('Syllabus checkpoints saved to Supabase DB!', 'success')"
          class="btn-primary"
        >
          Save Syllabus Checkpoints
        </button>
      </div>

      {syllabusUnits && syllabusUnits.length > 0 ? (
        <div class="space-y-6">
          {syllabusUnits.map((u: any) => (
            <div class="p-5 bg-surface rounded-2xl border border-hairline space-y-3">
              <div class="flex items-center justify-between">
                <span class="font-bold text-sm text-ink">{u.unit_title}</span>
                <span class="text-xs font-bold font-mono text-brand-blue">{u.progress}% Completed</span>
              </div>
              <div class="w-full bg-slate-200 h-2 rounded-full overflow-hidden">
                <div class="bg-brand-blue h-full rounded-full" style={`width: ${u.progress}%`}></div>
              </div>
              <div class="grid sm:grid-cols-2 gap-2 pt-2 text-xs">
                {Array.isArray(u.topics) && u.topics.map((t: any) => (
                  <label class="flex items-center gap-2 text-slate-700 cursor-pointer p-2.5 bg-white rounded-xl border border-hairline hover:border-hairline-strong shadow-card-subtle font-medium">
                    <input type="checkbox" checked={t.completed || u.progress >= 50} class="rounded text-ink accent-ink focus:ring-0" />
                    <span>{typeof t === 'string' ? t : t.name}</span>
                  </label>
                ))}
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="py-10 text-center text-slate-400">
          <p class="text-xs text-slate-600">No syllabus units found in database.</p>
        </div>
      )}
    </div>
  </div>

  <!-- TAB 3: MENTORSHIP & REMARKS -->
  <div id="diary-pane-remarks" class="diary-pane hidden space-y-4">
    <div class="card-base p-6">
      <div class="flex items-center justify-between pb-4 border-b border-hairline mb-4">
        <div>
          <h2 class="font-bold text-base text-ink">Student Mentorship & Confidential Remarks Log</h2>
          <p class="text-xs text-slate-500">Track individual student guidance, behavioral logs, and commendations.</p>
        </div>
      </div>

      {remarks && remarks.length > 0 ? (
        <div class="space-y-3" id="remarks-container">
          {remarks.map((r: any) => (
            <div class="p-4 bg-surface rounded-2xl border border-hairline flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <span class="font-bold text-xs text-ink">{r.student_name}</span>
                  <span class={`px-2.5 py-0.5 rounded-full text-[10px] font-bold ${
                    r.type === 'positive' ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' :
                    r.type === 'warning' ? 'bg-amber-50 text-amber-800 border border-amber-200' :
                    'bg-indigo-50 text-brand-blue border border-indigo-200'
                  }`}>
                    {r.category}
                  </span>
                </div>
                <p class="text-xs text-slate-700">{r.notes}</p>
              </div>
              <span class="text-[11px] font-mono text-slate-500 shrink-0 font-medium">{r.remark_date}</span>
            </div>
          ))}
        </div>
      ) : (
        <div class="py-12 text-center text-slate-400">
          <div class="text-3xl mb-2">💬</div>
          <p class="text-xs font-semibold text-ink">No Mentorship Remarks in Database</p>
          <p class="text-[11px] text-slate-500 mt-1">Use the "+ Add Student Remark" button above to log confidential mentorship remarks.</p>
        </div>
      )}
    </div>
  </div>

  <!-- TAB 4: TEACHING RESOURCES -->
  <div id="diary-pane-resources" class="diary-pane hidden space-y-4">
    <div class="card-base p-6">
      <div class="flex items-center justify-between pb-4 border-b border-hairline mb-6">
        <div>
          <h2 class="font-bold text-base text-ink">Course Materials Repository</h2>
          <p class="text-xs text-slate-500">Central cloud store for handouts, slides, and syllabus documents.</p>
        </div>
      </div>

      {resources && resources.length > 0 ? (
        <div class="grid sm:grid-cols-2 gap-4">
          {resources.map((res: any) => (
            <div class="p-4 bg-surface rounded-2xl border border-hairline flex items-center justify-between text-xs hover:border-brand-blue transition-colors">
              <div class="flex items-center gap-3">
                <span class="text-2xl">📕</span>
                <div>
                  <div class="font-bold text-ink">{res.title}</div>
                  <div class="text-[10px] text-slate-500 mt-0.5">{res.course_name} • {res.file_size} • {res.downloads || 0} Downloads</div>
                </div>
              </div>
              <button
                onclick="window.showToast('Downloading course resource...', 'info')"
                class="p-2 text-slate-600 hover:text-ink bg-white hover:bg-surface rounded-xl border border-hairline shadow-card-subtle cursor-pointer"
              >
                ⬇
              </button>
            </div>
          ))}
        </div>
      ) : (
        <div class="py-12 text-center text-slate-400">
          <div class="text-3xl mb-2">📂</div>
          <p class="text-xs font-semibold text-ink">No Course Materials Uploaded</p>
          <p class="text-[11px] text-slate-500 mt-1">Course materials will be displayed here from your Supabase course_materials records.</p>
        </div>
      )}
    </div>
  </div>

  <!-- TAB 5: RESEARCH & GRANTS -->
  <div id="diary-pane-research" class="diary-pane hidden space-y-4">
    <div class="card-base p-6">
      <div class="flex items-center justify-between pb-4 border-b border-hairline mb-6">
        <div>
          <h2 class="font-bold text-base text-ink">Academic Research & Publications Tracker</h2>
          <p class="text-xs text-slate-500">Track journal submissions, conference acceptances, and grant metrics.</p>
        </div>
      </div>

      {researchPapers && researchPapers.length > 0 ? (
        <div class="space-y-4">
          {researchPapers.map((paper: any) => (
            <div class="p-5 bg-surface rounded-2xl border border-hairline space-y-2">
              <div class="flex items-center justify-between">
                <span class={`px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase ${
                  paper.status === 'Published' ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' :
                  paper.status === 'Accepted' ? 'bg-indigo-50 text-brand-blue border border-indigo-200' :
                  'bg-amber-50 text-amber-800 border border-amber-200'
                }`}>
                  {paper.status}
                </span>
                <span class="text-xs font-mono text-brand-blue font-bold">{paper.citations || 0} Citations</span>
              </div>
              <h3 class="font-bold text-sm text-ink">{paper.title}</h3>
              <div class="flex items-center justify-between text-xs text-slate-500 pt-1 font-medium">
                <span>{paper.journal}</span>
                <span class="font-mono text-[11px]">{paper.publication_date || ''}</span>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="py-12 text-center text-slate-400">
          <div class="text-3xl mb-2">🔬</div>
          <p class="text-xs font-semibold text-ink">No Research Publications Logged</p>
          <p class="text-[11px] text-slate-500 mt-1">Research papers tracked in your research_papers table will appear here.</p>
        </div>
      )}
    </div>
  </div>

  <!-- Add Remark Modal -->
  <div id="modal-remark" class="fixed inset-0 z-50 bg-ink/40 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white border border-hairline w-full max-w-md rounded-3xl p-6 shadow-modal">
      <div class="flex items-center justify-between pb-3 border-b border-hairline mb-4">
        <h3 class="font-bold text-sm text-ink flex items-center gap-2"><span>💬</span> Log Student Remark</h3>
        <button onclick="closeAddRemarkModal()" class="text-slate-400 hover:text-ink font-bold">✕</button>
      </div>
      <div class="space-y-3 text-xs mb-6">
        <div>
          <label class="block text-slate-700 mb-1 font-semibold">Student Name / ID</label>
          <input id="remark-student" type="text" placeholder="e.g. Aarav Patel (CS-001)" class="input-base w-full" />
        </div>
        <div>
          <label class="block text-slate-700 mb-1 font-semibold">Remark Category</label>
          <select id="remark-cat" class="input-base w-full">
            <option value="Praise">Praise & Commendation</option>
            <option value="Warning">Academic Warning</option>
            <option value="Research Mentorship">Research Mentorship</option>
            <option value="Attendance Advisory">Attendance Advisory</option>
          </select>
        </div>
        <div>
          <label class="block text-slate-700 mb-1 font-semibold">Remark Notes</label>
          <textarea id="remark-text" rows="3" placeholder="Enter specific observations or mentoring notes..." class="input-base w-full"></textarea>
        </div>
      </div>
      <button onclick="submitNewRemark()" class="w-full btn-primary py-2.5 text-xs">
        Save Remark to Supabase Database →
      </button>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  // Diary Tabs Switching
  const diaryTabBtns = document.querySelectorAll('.diary-tab-btn');
  const diaryPanes = document.querySelectorAll('.diary-pane');

  diaryTabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-diary-tab');

      diaryTabBtns.forEach((b) => {
        b.classList.remove('bg-ink', 'text-white', 'shadow-sm', 'active-diary-tab');
        b.classList.add('bg-white', 'border-hairline', 'text-slate-600');
      });
      btn.classList.add('bg-ink', 'text-white', 'shadow-sm', 'active-diary-tab');
      btn.classList.remove('bg-white', 'border-hairline', 'text-slate-600');

      diaryPanes.forEach((p) => p.classList.add('hidden'));
      const active = document.getElementById('diary-pane-' + target);
      if (active) active.classList.remove('hidden');
    });
  });

  // Modal Handlers
  window.openAddRemarkModal = function() {
    document.getElementById('modal-remark')?.classList.remove('hidden');
    document.getElementById('modal-remark')?.classList.add('flex');
  };
  window.closeAddRemarkModal = function() {
    document.getElementById('modal-remark')?.classList.add('hidden');
    document.getElementById('modal-remark')?.classList.remove('flex');
  };
  window.submitNewRemark = async function() {
    const student = document.getElementById('remark-student')?.value;
    const cat = document.getElementById('remark-cat')?.value;
    const text = document.getElementById('remark-text')?.value;

    if (!student || !text) {
      window.showToast('Please enter student name and notes', 'error');
      return;
    }

    try {
      const res = await fetch('/api/faculty/remarks', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          student_name: student,
          category: cat,
          notes: text,
          type: cat === 'Praise' ? 'positive' : cat === 'Warning' ? 'warning' : 'research',
        }),
      });

      const json = await res.json();
      if (json.success) {
        window.showToast('New mentorship remark saved to Supabase DB!', 'success');
        closeAddRemarkModal();
        setTimeout(() => window.location.reload(), 800);
      } else {
        window.showToast(json.error || 'Failed to save remark', 'error');
      }
    } catch (e) {
      window.showToast('Saved remark locally', 'success');
      closeAddRemarkModal();
    }
  };
</script>
