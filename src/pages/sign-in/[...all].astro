---
import '../../styles/global.css';
import { SignIn } from '@clerk/astro/components';

const { userId } = Astro.locals.auth();
if (userId) {
  return Astro.redirect('/dashboard');
}

const clerkAppearance = {
  variables: {
    colorPrimary: '#1c1c1e',
    colorText: '#1c1c1e',
    colorTextSecondary: '#555a6a',
    colorBackground: '#ffffff',
    colorInputBackground: '#ffffff',
    colorInputBorder: '#e0e2e8',
    borderRadius: '0.75rem',
    fontFamily: "'Plus Jakarta Sans', system-ui, -apple-system, BlinkMacSystemFont, sans-serif",
  },
  elements: {
    card: 'shadow-card border border-hairline rounded-2xl bg-white p-6 sm:p-8 w-full',
    headerTitle: 'text-2xl font-extrabold text-ink tracking-tight',
    headerSubtitle: 'text-xs text-slate-500 mt-1',
    socialButtonsBlockButton: 'rounded-xl border border-hairline hover:bg-surface text-xs font-semibold text-ink transition-all py-2.5 shadow-sm',
    socialButtonsBlockButtonText: 'text-xs font-semibold text-ink',
    formButtonPrimary: 'bg-ink hover:bg-charcoal text-white rounded-full text-xs font-semibold py-3 transition-all shadow-sm active:scale-[0.98] cursor-pointer',
    formFieldLabel: 'text-xs font-semibold text-slate-700 mb-1.5',
    formFieldInput: 'rounded-xl border border-hairline-strong text-xs px-3.5 py-2.5 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 transition-all bg-white',
    footerActionLink: 'text-brand-blue hover:underline font-semibold text-xs',
    footerActionText: 'text-xs text-slate-500',
    dividerLine: 'bg-hairline',
    dividerText: 'text-[11px] text-slate-400 font-semibold uppercase tracking-wider',
    formFieldAction: 'text-xs text-brand-blue hover:underline font-medium',
    identityPreviewText: 'text-xs font-medium text-ink',
    identityPreviewEditButton: 'text-xs text-brand-blue hover:underline font-semibold',
  },
};
---

<!doctype html>
<html lang="en" class="h-full bg-surface-soft">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In — SynapseFlow Cloud Suite</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-surface-soft text-ink selection:bg-brand-yellow/40 selection:text-ink flex flex-col font-sans">
    <!-- Top Navigation Header -->
    <header class="w-full bg-white/90 backdrop-blur-md border-b border-hairline py-3.5 px-6 sm:px-10 sticky top-0 z-30 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-8 h-8 rounded-xl bg-brand-yellow flex items-center justify-center text-ink font-bold shadow-sm group-hover:scale-105 transition-transform">
          <svg class="w-4 h-4 text-ink" fill="currentColor" viewBox="0 0 24 24">
            <path d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="font-extrabold text-base tracking-tight text-ink">SynapseFlow</span>
          <span class="text-[10px] font-bold text-brand-yellow-dark bg-brand-yellow-light border border-brand-yellow/40 px-2 py-0.5 rounded-full">OS 2.4</span>
        </div>
      </a>

      <div class="flex items-center gap-3 text-xs">
        <span class="text-slate-500 hidden sm:inline">Don't have an account?</span>
        <a href="/sign-up" class="btn-secondary py-1.5 px-4 text-xs font-semibold">
          Create Account →
        </a>
      </div>
    </header>

    <!-- Main Content Area: Two-Column Split on Desktop -->
    <main class="flex-1 flex items-center justify-center p-4 sm:p-8 lg:p-12">
      <div class="w-full max-w-6xl grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        
        <!-- Left Column: Value Proposition & Product Showcase -->
        <div class="lg:col-span-6 space-y-6 hidden lg:block pr-4">
          <!-- Tag Chip -->
          <div class="inline-flex items-center gap-2 bg-brand-yellow-light border border-brand-yellow/40 rounded-full px-3.5 py-1 text-xs text-brand-yellow-dark font-semibold shadow-sm">
            <span class="w-2 h-2 rounded-full bg-brand-yellow-deep animate-pulse"></span>
            <span>Enterprise Productivity OS</span>
            <span class="text-brand-yellow-dark/40">•</span>
            <span class="text-ink font-medium">Single Sign-On</span>
          </div>

          <h1 class="text-4xl xl:text-5xl font-extrabold text-ink tracking-tight leading-[1.12]">
            Welcome back to your <br />
            <span class="underline decoration-brand-yellow decoration-wavy decoration-2">unified command center.</span>
          </h1>

          <p class="text-sm text-slate-600 leading-relaxed max-w-lg">
            Sign in to access high-speed PDF tools, AI-powered ATS resume intelligence, class attendance rosters, and academic faculty diaries in real-time.
          </p>

          <!-- 4 Workspace Feature Pills -->
          <div class="grid grid-cols-2 gap-3 pt-2">
            <div class="p-3.5 bg-white border border-hairline rounded-2xl shadow-card-subtle flex items-start gap-3">
              <span class="text-xl p-2 bg-brand-rose/40 rounded-xl">📄</span>
              <div>
                <h2 class="font-bold text-xs text-ink">PDF Studio</h2>
                <p class="text-[11px] text-slate-500 mt-0.5">Merge, OCR & compression</p>
              </div>
            </div>

            <div class="p-3.5 bg-white border border-hairline rounded-2xl shadow-card-subtle flex items-start gap-3">
              <span class="text-xl p-2 bg-brand-teal/40 rounded-xl">🎯</span>
              <div>
                <h2 class="font-bold text-xs text-ink">ATS Resume AI</h2>
                <p class="text-[11px] text-slate-500 mt-0.5">Instant scoring & keywords</p>
              </div>
            </div>

            <div class="p-3.5 bg-white border border-hairline rounded-2xl shadow-card-subtle flex items-start gap-3">
              <span class="text-xl p-2 bg-brand-yellow/40 rounded-xl">📋</span>
              <div>
                <h2 class="font-bold text-xs text-ink">Campus Attendance</h2>
                <p class="text-[11px] text-slate-500 mt-0.5">Rosters & live analytics</p>
              </div>
            </div>

            <div class="p-3.5 bg-white border border-hairline rounded-2xl shadow-card-subtle flex items-start gap-3">
              <span class="text-xl p-2 bg-brand-coral/40 rounded-xl">📚</span>
              <div>
                <h2 class="font-bold text-xs text-ink">Faculty Diary</h2>
                <p class="text-[11px] text-slate-500 mt-0.5">Timetables & research logs</p>
              </div>
            </div>
          </div>

          <!-- Social Proof / Security Footer -->
          <div class="pt-4 border-t border-hairline flex items-center justify-between text-xs text-slate-500">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-brand-success"></span>
              <span>All Systems Operational</span>
            </div>
            <div class="flex items-center gap-3">
              <span>🔒 SOC2 Type II</span>
              <span>•</span>
              <span>256-bit Encryption</span>
            </div>
          </div>
        </div>

        <!-- Right Column: Clerk Auth Card -->
        <div class="lg:col-span-6 flex flex-col items-center justify-center">
          <div class="w-full max-w-md">
            <!-- Mobile Brand Header (Visible on smaller screens) -->
            <div class="text-center mb-6 lg:hidden">
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-brand-yellow text-ink font-bold text-xl shadow-sm mb-3">
                <svg class="w-6 h-6 text-ink" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <h2 class="text-2xl font-extrabold text-ink tracking-tight">Sign in to SynapseFlow</h2>
              <p class="text-xs text-slate-600 mt-1">Unified cloud workspace for documents & academics</p>
            </div>

            <!-- Clerk Interactive SignIn Component -->
            <div class="flex justify-center">
              <SignIn
                path="/sign-in"
                routing="path"
                signUpUrl="/sign-up"
                fallbackRedirectUrl="/dashboard"
                appearance={clerkAppearance}
              />
            </div>

            <!-- Bottom Back Link -->
            <div class="text-center mt-6">
              <a href="/" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-ink transition-colors">
                <span>←</span>
                <span>Back to SynapseFlow Homepage</span>
              </a>
            </div>
          </div>
        </div>

      </div>
    </main>

    <!-- Footer -->
    <footer class="py-4 px-6 border-t border-hairline bg-white text-center text-xs text-slate-400">
      <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2">
        <p>© 2026 SynapseFlow Systems Inc. All rights reserved.</p>
        <div class="flex items-center gap-4">
          <a href="/sign-up" class="hover:text-ink">Sign Up</a>
          <span>•</span>
          <a href="/dashboard" class="hover:text-ink">Command Center</a>
          <span>•</span>
          <a href="/" class="hover:text-ink">Public Home</a>
        </div>
      </div>
    </footer>
  </body>
</html>
