---
import '../styles/global.css';
import { Show, SignInButton, UserButton } from '@clerk/astro/components';

interface Props {
  title: string;
  activePage?: string;
  subtitle?: string;
}

const { title, activePage = 'dashboard', subtitle = 'Enterprise Productivity OS' } = Astro.props;

const navItems = [
  { label: 'Command Center', href: '/dashboard', icon: '⚡', id: 'dashboard', badge: 'Live' },
  { label: 'PDF Studio', href: '/pdf-tools', icon: '📄', id: 'pdf-tools', badge: '7 Tools' },
  { label: 'ATS Resume AI', href: '/ats-checker', icon: '🎯', id: 'ats-checker', badge: 'AI Pro' },
  { label: 'Campus Attendance', href: '/attendance', icon: '📋', id: 'attendance', badge: 'Active' },
  { label: 'Faculty Diary', href: '/faculty-diary', icon: '📚', id: 'faculty-diary', badge: 'Academic' },
  { label: 'Unified Analytics', href: '/analytics', icon: '📈', id: 'analytics' },
  { label: 'Workspace Settings', href: '/settings', icon: '⚙️', id: 'settings' },
];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — SynapseFlow SaaS</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-surface-soft text-ink min-h-screen flex flex-col font-sans selection:bg-brand-yellow/40 selection:text-ink">
    <!-- Main App Frame -->
    <div class="relative flex min-h-screen">
      <!-- Sidebar -->
      <aside class="w-64 bg-white border-r border-hairline flex flex-col fixed top-0 bottom-0 left-0 z-30 transition-all duration-300 shadow-card-subtle">
        <!-- Brand Header -->
        <div class="p-5 border-b border-hairline flex items-center justify-between">
          <a href="/dashboard" class="flex items-center gap-3 group">
            <div class="w-9 h-9 rounded-xl bg-brand-yellow flex items-center justify-center text-ink font-bold shadow-sm group-hover:scale-105 transition-transform duration-200">
              <svg class="w-5 h-5 text-ink" fill="currentColor" viewBox="0 0 24 24">
                <path d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <div>
              <div class="flex items-center gap-1.5">
                <span class="font-bold text-base tracking-tight text-ink">SynapseFlow</span>
              </div>
              <span class="text-[10px] uppercase font-semibold tracking-wider text-slate-500">Cloud Suite OS</span>
            </div>
          </a>
          <span class="px-2 py-0.5 text-[10px] font-bold bg-brand-yellow-light text-brand-yellow-dark rounded-full border border-brand-yellow/40">v2.4</span>
        </div>

        <!-- Quick Switcher Context -->
        <div class="px-3 pt-3">
          <div class="bg-surface border border-hairline rounded-xl p-2.5 flex items-center justify-between text-xs">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-brand-success"></span>
              <span class="text-ink font-medium text-xs">Main Workspace</span>
            </div>
            <span class="text-[10px] font-semibold text-slate-500 bg-white border border-hairline px-2 py-0.5 rounded-full">Pro Org</span>
          </div>
        </div>

        <!-- Navigation Menu -->
        <nav class="flex-1 p-3 space-y-1.5 overflow-y-auto mt-2">
          <div class="px-3 py-1.5 text-[11px] font-semibold text-slate-400 uppercase tracking-wider">
            Workspaces & Tools
          </div>

          {navItems.map((item) => (
            <a
              href={item.href}
              class={`flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-medium transition-all group ${
                activePage === item.id
                  ? 'bg-ink text-white shadow-sm font-semibold'
                  : 'text-slate-600 hover:bg-surface hover:text-ink'
              }`}
            >
              <div class="flex items-center gap-3">
                <span class="text-base group-hover:scale-110 transition-transform">{item.icon}</span>
                <span>{item.label}</span>
              </div>
              {item.badge && (
                <span
                  class={`text-[10px] font-semibold px-2 py-0.5 rounded-full ${
                    activePage === item.id
                      ? 'bg-white/20 text-white'
                      : 'bg-surface text-slate-500 border border-hairline group-hover:border-hairline-strong'
                  }`}
                >
                  {item.badge}
                </span>
              )}
            </a>
          ))}

          <div class="pt-4 px-3 py-1.5 text-[11px] font-semibold text-slate-400 uppercase tracking-wider">
            Quick Portals
          </div>
          <a
            href="/"
            class="flex items-center gap-3 px-3.5 py-2 rounded-xl text-xs font-medium text-slate-600 hover:bg-surface hover:text-ink transition-all"
          >
            <span>🌐</span>
            <span>Public Landing Page</span>
          </a>
        </nav>

        <!-- Sidebar Footer & Storage Widget -->
        <div class="p-3 border-t border-hairline space-y-3">
          <!-- Mini Storage Meter -->
          <div class="bg-surface border border-hairline rounded-xl p-3">
            <div class="flex justify-between items-center text-xs mb-1.5">
              <span class="text-slate-600 font-medium">Cloud Vault</span>
              <span class="text-brand-blue font-mono font-bold text-[11px]">4.2 GB / 10 GB</span>
            </div>
            <div class="w-full bg-hairline h-1.5 rounded-full overflow-hidden">
              <div class="bg-brand-blue h-full rounded-full w-[42%]"></div>
            </div>
          </div>

          <!-- User Profile -->
          <div class="flex items-center justify-between p-2 rounded-xl bg-surface border border-hairline">
            <Show when="signed-in">
              <div class="flex items-center gap-2.5 min-w-0">
                <UserButton />
                <div class="truncate">
                  <p class="text-xs font-semibold text-ink truncate">Account</p>
                  <p class="text-[10px] text-slate-500 truncate">Pro Workspace</p>
                </div>
              </div>
            </Show>
            <Show when="signed-out">
              <a href="/sign-in" class="w-full text-center text-xs font-semibold py-1.5 px-3 bg-brand-yellow hover:bg-brand-yellow-deep text-ink rounded-lg transition-colors cursor-pointer block">
                Sign In / Sign Up
              </a>
            </Show>
            <a href="/settings" title="Profile Settings" class="p-1 text-slate-400 hover:text-ink hover:bg-white rounded-lg transition-colors border border-transparent hover:border-hairline">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </a>
          </div>
        </div>
      </aside>

      <!-- Main Body Content Area -->
      <div class="ml-64 flex-1 flex flex-col min-h-screen">
        <!-- Top Sticky Header -->
        <header class="sticky top-0 z-20 bg-white/90 backdrop-blur-md border-b border-hairline px-8 py-3.5 flex items-center justify-between shadow-card-subtle">
          <!-- Left: Breadcrumb & Title -->
          <div class="flex items-center gap-3">
            <div class="flex items-center gap-2 text-xs text-slate-500">
              <span class="hover:text-ink font-medium">SynapseFlow</span>
              <span>/</span>
              <span class="text-ink font-semibold capitalize">{activePage.replace('-', ' ')}</span>
            </div>
          </div>

          <!-- Center: Command Palette Trigger -->
          <div class="hidden md:flex items-center">
            <button
              id="cmd-palette-btn"
              class="flex items-center gap-3 bg-surface border border-hairline hover:border-brand-blue hover:bg-white px-4 py-1.5 rounded-full text-xs text-slate-500 hover:text-ink transition-all w-72 justify-between cursor-pointer"
            >
              <div class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <span>Search tools or run actions...</span>
              </div>
              <kbd class="px-1.5 py-0.5 text-[10px] font-mono bg-white border border-hairline text-slate-500 rounded-md font-semibold">⌘K</kbd>
            </button>
          </div>

          <!-- Right: System Controls & Notifications -->
          <div class="flex items-center gap-3">
            <!-- Clerk Auth Controls in Top Header -->
            <Show when="signed-in">
              <UserButton />
            </Show>
            <Show when="signed-out">
              <a href="/sign-in" class="text-xs font-semibold px-3 py-1.5 bg-ink text-white rounded-lg hover:bg-slate-800 transition-colors cursor-pointer">
                Sign In
              </a>
            </Show>
            <!-- Fast Status indicator -->
            <div class="hidden sm:flex items-center gap-2 bg-emerald-50 border border-emerald-200 px-3 py-1 rounded-full text-[11px] text-emerald-700 font-medium">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>Cloud Sync 24ms</span>
            </div>

            <!-- Notification Bell -->
            <div class="relative" id="notif-container">
              <button
                id="notif-btn"
                class="relative p-2 text-slate-500 hover:text-ink hover:bg-surface rounded-full transition-colors border border-transparent hover:border-hairline"
                title="Notifications"
              >
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                </svg>
                <span class="absolute top-1.5 right-1.5 w-2 h-2 bg-brand-blue rounded-full"></span>
              </button>

              <!-- Notifications Dropdown -->
              <div id="notif-dropdown" class="hidden absolute right-0 mt-2 w-80 bg-white border border-hairline rounded-2xl shadow-modal p-4 z-50 animate-fadeIn">
                <div class="flex items-center justify-between pb-3 border-b border-hairline mb-2">
                  <span class="font-bold text-xs text-ink">Recent Notifications</span>
                  <span class="text-[10px] text-brand-blue font-semibold hover:underline cursor-pointer">Mark all read</span>
                </div>
                <div class="space-y-2 text-xs">
                  <div class="p-2.5 bg-surface rounded-xl border border-hairline-soft">
                    <p class="font-semibold text-ink">✨ PDF Batch Compressed</p>
                    <p class="text-slate-500 text-[11px] mt-0.5">3 files compressed (saved 12.4 MB)</p>
                    <span class="text-[9px] text-slate-400">2 min ago</span>
                  </div>
                  <div class="p-2.5 bg-surface rounded-xl border border-hairline-soft">
                    <p class="font-semibold text-ink">🎯 ATS Resume Scan Done</p>
                    <p class="text-slate-500 text-[11px] mt-0.5">Score: 84/100 (Strong Match)</p>
                    <span class="text-[9px] text-slate-400">18 min ago</span>
                  </div>
                  <div class="p-2.5 bg-surface rounded-xl border border-hairline-soft">
                    <p class="font-semibold text-ink">📋 Attendance Synchronized</p>
                    <p class="text-slate-500 text-[11px] mt-0.5">CS-301 Data Structures marked present</p>
                    <span class="text-[9px] text-slate-400">1 hour ago</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Quick Action Button (Black Pill from DESIGN.md) -->
            <a
              href="/pdf-tools"
              class="btn-primary flex items-center gap-1.5"
            >
              <span>+</span>
              <span>Quick Action</span>
            </a>
          </div>
        </header>

        <!-- Dynamic Main Workspace Content -->
        <main class="flex-1 p-8">
          <slot />
        </main>

        <!-- Footer -->
        <footer class="border-t border-hairline bg-white px-8 py-4 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-2">
          <div class="flex items-center gap-2">
            <span class="font-bold text-ink">SynapseFlow OS</span>
            <span>•</span>
            <span>Unified SaaS Engine</span>
          </div>
          <div class="flex items-center gap-4">
            <a href="/dashboard" class="hover:text-ink">Dashboard</a>
            <a href="/pdf-tools" class="hover:text-ink">PDF Tools</a>
            <a href="/ats-checker" class="hover:text-ink">ATS AI</a>
            <a href="/attendance" class="hover:text-ink">Attendance</a>
            <a href="/faculty-diary" class="hover:text-ink">Diary</a>
          </div>
        </footer>
      </div>
    </div>

    <!-- Interactive Command Palette Modal (⌘K) -->
    <div id="cmd-modal" class="fixed inset-0 z-50 bg-ink/40 backdrop-blur-sm hidden items-center justify-center p-4">
      <div class="bg-white border border-hairline w-full max-w-xl rounded-2xl shadow-modal overflow-hidden animate-fadeIn">
        <div class="p-4 border-b border-hairline flex items-center gap-3 bg-surface-soft">
          <svg class="w-5 h-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            id="cmd-input"
            type="text"
            placeholder="Type a tool name or command (e.g. Merge, ATS, Attendance, Schedule)..."
            class="flex-1 bg-transparent border-none text-ink placeholder-slate-400 text-sm focus:outline-none"
          />
          <button id="cmd-close" class="text-slate-500 hover:text-ink text-xs px-2 py-1 bg-surface border border-hairline rounded-lg font-semibold">ESC</button>
        </div>

        <div class="p-3 max-h-96 overflow-y-auto space-y-1 text-sm" id="cmd-results">
          <div class="text-[11px] font-semibold text-slate-400 uppercase px-3 py-1">Quick Navigation</div>
          <a href="/dashboard" class="flex items-center gap-3 px-3 py-2 rounded-xl text-slate-700 hover:bg-surface hover:text-ink transition-colors">
            <span>⚡</span>
            <div class="flex-1">
              <div class="font-semibold text-xs text-ink">Command Center Dashboard</div>
              <div class="text-[11px] text-slate-500">View overall analytics and metrics</div>
            </div>
            <kbd class="text-[10px] text-slate-400 font-mono bg-surface border border-hairline px-1.5 py-0.5 rounded">/dashboard</kbd>
          </a>
          <a href="/pdf-tools" class="flex items-center gap-3 px-3 py-2 rounded-xl text-slate-700 hover:bg-surface hover:text-ink transition-colors">
            <span>📄</span>
            <div class="flex-1">
              <div class="font-semibold text-xs text-ink">PDF Power Studio</div>
              <div class="text-[11px] text-slate-500">Merge, split, compress, watermark, OCR</div>
            </div>
            <kbd class="text-[10px] text-slate-400 font-mono bg-surface border border-hairline px-1.5 py-0.5 rounded">/pdf-tools</kbd>
          </a>
          <a href="/ats-checker" class="flex items-center gap-3 px-3 py-2 rounded-xl text-slate-700 hover:bg-surface hover:text-ink transition-colors">
            <span>🎯</span>
            <div class="flex-1">
              <div class="font-semibold text-xs text-ink">ATS Resume Intelligence</div>
              <div class="text-[11px] text-slate-500">Score & optimize resumes for job descriptions</div>
            </div>
            <kbd class="text-[10px] text-slate-400 font-mono bg-surface border border-hairline px-1.5 py-0.5 rounded">/ats-checker</kbd>
          </a>
          <a href="/attendance" class="flex items-center gap-3 px-3 py-2 rounded-xl text-slate-700 hover:bg-surface hover:text-ink transition-colors">
            <span>📋</span>
            <div class="flex-1">
              <div class="font-semibold text-xs text-ink">Campus Attendance Manager</div>
              <div class="text-[11px] text-slate-500">Mark student presence, batches, and exports</div>
            </div>
            <kbd class="text-[10px] text-slate-400 font-mono bg-surface border border-hairline px-1.5 py-0.5 rounded">/attendance</kbd>
          </a>
          <a href="/faculty-diary" class="flex items-center gap-3 px-3 py-2 rounded-xl text-slate-700 hover:bg-surface hover:text-ink transition-colors">
            <span>📚</span>
            <div class="flex-1">
              <div class="font-semibold text-xs text-ink">Faculty Academic Diary</div>
              <div class="text-[11px] text-slate-500">Timetable, lesson plans, research & remarks</div>
            </div>
            <kbd class="text-[10px] text-slate-400 font-mono bg-surface border border-hairline px-1.5 py-0.5 rounded">/faculty-diary</kbd>
          </a>
          <a href="/analytics" class="flex items-center gap-3 px-3 py-2 rounded-xl text-slate-700 hover:bg-surface hover:text-ink transition-colors">
            <span>📈</span>
            <div class="flex-1">
              <div class="font-semibold text-xs text-ink">Unified Insights & Reporting</div>
              <div class="text-[11px] text-slate-500">Performance metrics across all tools</div>
            </div>
            <kbd class="text-[10px] text-slate-400 font-mono bg-surface border border-hairline px-1.5 py-0.5 rounded">/analytics</kbd>
          </a>
        </div>
      </div>
    </div>

    <!-- Global Toast Notification System -->
    <div id="toast-box" class="fixed bottom-6 right-6 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <script is:inline>
      // Global Toast Notification Helper
      window.showToast = function(message, type = 'success') {
        const container = document.getElementById('toast-box');
        if (!container) return;
        const toast = document.createElement('div');
        toast.className = `px-4 py-3 rounded-xl text-xs font-semibold shadow-modal flex items-center gap-2.5 transform transition-all duration-300 pointer-events-auto border ${
          type === 'success' ? 'bg-white border-emerald-300 text-emerald-800 shadow-emerald-500/10' :
          type === 'error' ? 'bg-white border-rose-300 text-rose-800 shadow-rose-500/10' :
          'bg-white border-brand-blue/30 text-ink shadow-brand-blue/10'
        }`;
        const icon = type === 'success' ? '✓' : type === 'error' ? '✕' : 'ℹ';
        toast.innerHTML = `<span class="w-5 h-5 rounded-full flex items-center justify-center text-xs font-bold ${
          type === 'success' ? 'bg-emerald-100 text-emerald-700' :
          type === 'error' ? 'bg-rose-100 text-rose-700' :
          'bg-brand-blue-light text-brand-blue'
        }">${icon}</span> <span class="font-medium">${message}</span>`;
        container.appendChild(toast);
        setTimeout(() => {
          toast.style.opacity = '0';
          toast.style.transform = 'translateY(10px)';
          setTimeout(() => toast.remove(), 300);
        }, 3200);
      };

      // Command Palette Trigger Logic
      const cmdBtn = document.getElementById('cmd-palette-btn');
      const cmdModal = document.getElementById('cmd-modal');
      const cmdClose = document.getElementById('cmd-close');
      const cmdInput = document.getElementById('cmd-input');

      function openCmd() {
        if (cmdModal) {
          cmdModal.classList.remove('hidden');
          cmdModal.classList.add('flex');
          cmdInput?.focus();
        }
      }

      function closeCmd() {
        if (cmdModal) {
          cmdModal.classList.add('hidden');
          cmdModal.classList.remove('flex');
        }
      }

      cmdBtn?.addEventListener('click', openCmd);
      cmdClose?.addEventListener('click', closeCmd);

      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          if (cmdModal?.classList.contains('hidden')) {
            openCmd();
          } else {
            closeCmd();
          }
        }
        if (e.key === 'Escape') {
          closeCmd();
        }
      });

      cmdModal?.addEventListener('click', (e) => {
        if (e.target === cmdModal) closeCmd();
      });

      // Search filter in command palette
      cmdInput?.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase();
        const links = document.querySelectorAll('#cmd-results a');
        links.forEach((link) => {
          const text = link.textContent?.toLowerCase() || '';
          if (text.includes(query)) {
            link.style.display = 'flex';
          } else {
            link.style.display = 'none';
          }
        });
      });

      // Notification Dropdown Toggle
      const notifBtn = document.getElementById('notif-btn');
      const notifDropdown = document.getElementById('notif-dropdown');
      notifBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        notifDropdown?.classList.toggle('hidden');
      });
      document.addEventListener('click', () => {
        notifDropdown?.classList.add('hidden');
      });
    </script>
  </body>
</html>
